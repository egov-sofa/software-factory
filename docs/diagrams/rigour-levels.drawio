        <object id="title" label="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Levels of rigour, L0 to L3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6775&quot;&gt;A cheap classifier proposes the level and you confirm it; only L2 and L3 add architects and a review board, so cost follows the risk of the change.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5A6775&quot;&gt;bpmn | draft | v1 | 2026-11-11 | software-factory&lt;/font&gt;" diagram.title="Levels of rigour, L0 to L3" diagram.statement="A cheap classifier proposes the level and you confirm it; only L2 and L3 add architects and a review board, so cost follows the risk of the change." diagram.notation="bpmn" diagram.status="draft" diagram.version="1" diagram.date="2026-11-11" diagram.author="software-factory" diagram.viewpoint="process"><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="620" height="80" as="geometry"/></mxCell></object>
