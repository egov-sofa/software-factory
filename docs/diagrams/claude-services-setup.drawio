        <object id="title" label="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Setting a repository up for the Claude review&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6775&quot;&gt;Claude Code prepares and previews; a person with the org:admin login runs one command; the script turns the review on last, and never while a stored key would win over federation.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5A6775&quot;&gt;bpmn | approved | v1 | 2026-11-19 | software-factory&lt;/font&gt;" diagram.title="Setting a repository up for the Claude review" diagram.statement="Claude Code prepares and previews; a person with the org:admin login runs one command; the script turns the review on last, and never while a stored key would win over federation." diagram.notation="bpmn" diagram.status="approved" diagram.version="1" diagram.date="2026-11-19" diagram.author="software-factory" diagram.viewpoint="process"><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="620" height="80" as="geometry"/></mxCell></object>
