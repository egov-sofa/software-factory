        <object id="title" label="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Where Claude's rules come from&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6775&quot;&gt;Standards are written once; the global block applies everywhere, each project's CLAUDE.md adds detail and wins on conflict, agents check against the standards.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5A6775&quot;&gt;c4 | approved | v2 | 2026-11-11 | software-factory&lt;/font&gt;" diagram.title="Where Claude's rules come from" diagram.statement="Standards are written once; the global block applies everywhere, each project's CLAUDE.md adds detail and wins on conflict, agents check against the standards." diagram.notation="c4" diagram.status="approved" diagram.version="2" diagram.date="2026-11-11" diagram.author="software-factory" diagram.viewpoint="solution"><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="620" height="80" as="geometry"/></mxCell></object>
