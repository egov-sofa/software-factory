        <object id="title" label="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;The architecture roles, by layer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6775&quot;&gt;Strategic roles write reusable artifacts once; the Solution architect leads each design and calls specialists only when the change touches their area.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5A6775&quot;&gt;archimate | draft | v1 | 2026-11-11 | software-factory&lt;/font&gt;" diagram.title="The architecture roles, by layer" diagram.statement="Strategic roles write reusable artifacts once; the Solution architect leads each design and calls specialists only when the change touches their area." diagram.notation="archimate" diagram.status="draft" diagram.version="1" diagram.date="2026-11-11" diagram.author="software-factory" diagram.viewpoint="layered"><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="620" height="80" as="geometry"/></mxCell></object>
