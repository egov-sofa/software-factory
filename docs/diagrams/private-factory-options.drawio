        <object id="title" label="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;E. Workflows copied into each project&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6775&quot;&gt;Projects stop calling the factory; the weekly update pull request copies the workflows and actions in, reading the private factory with an App token.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5A6775&quot;&gt;c4 | review | v1 | 2026-11-21 | software-factory&lt;/font&gt;" diagram.title="E. Workflows copied into each project" diagram.statement="Projects stop calling the factory; the weekly update pull request copies the workflows and actions in, reading the private factory with an App token." diagram.notation="c4" diagram.status="review" diagram.version="1" diagram.date="2026-11-21" diagram.author="software-factory" diagram.viewpoint="solution"><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="620" height="80" as="geometry"/></mxCell></object>
