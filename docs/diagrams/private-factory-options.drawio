        <object id="edge-update-factory" label="reads a&lt;br&gt;release" kind="identity" payload="reads a release" primary="true"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;fontSize=13;fontColor=#5A6775;labelBackgroundColor=#FFFFFF;strokeColor=#0B5FA5;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;spacingBottom=3;labelBackgroundColor=none;" edge="1" parent="1" source="update" target="factory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="edge-update-local" label="update pull request" kind="file" payload="update pull request"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;fontSize=13;fontColor=#5A6775;labelBackgroundColor=#FFFFFF;strokeColor=#5A6775;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;verticalAlign=middle;labelBackgroundColor=none;" edge="1" parent="1" source="update" target="local"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="0" as="offset"/></mxGeometry></mxCell></object>
        <object id="edge-guard-local" label="runs from&lt;br&gt;main, not the&lt;br&gt;PR" kind="sync" payload="runs from main, not the PR"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;fontSize=13;fontColor=#5A6775;labelBackgroundColor=#FFFFFF;strokeColor=#1F2933;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;verticalAlign=middle;labelBackgroundColor=none;" edge="1" parent="1" source="guard" target="local"><mxGeometry relative="1" as="geometry"><mxPoint x="57" y="0" as="offset"/></mxGeometry></mxCell></object>
