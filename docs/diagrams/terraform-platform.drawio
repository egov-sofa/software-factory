        <object id="title" label="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;How an approved change reaches GitHub and Anthropic&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6775&quot;&gt;GitHub signs who the apply job is and Anthropic gives it a 10-minute org:admin token, keyless; the GitHub App's private key is the one stored secret.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5A6775&quot;&gt;c4 | draft | v1 | 2026-11-19 | software-factory&lt;/font&gt;" diagram.title="How an approved change reaches GitHub and Anthropic" diagram.statement="GitHub signs who the apply job is and Anthropic gives it a 10-minute org:admin token, keyless; the GitHub App's private key is the one stored secret." diagram.notation="c4" diagram.status="draft" diagram.version="1" diagram.date="2026-11-19" diagram.author="software-factory" diagram.viewpoint="solution"><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="620" height="80" as="geometry"/></mxCell></object>
